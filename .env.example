# ── Database (Supabase Postgres, via Prisma) ────────────────────────────────
# Get these from Supabase → Project Settings → Database → Connection string
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# ── Supabase (Storage & Auth) ───────────────────────────────────────────────
# Get these from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Also from Project Settings → API, under "Project API keys" — the "service_role"
# key (NOT the anon key). This is SECRET — it powers image uploads from the
# admin panel and must never be shown in the browser or committed to GitHub.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Auth ─────────────────────────────────────────────────────────────────
# Any long random string — used to sign customer & admin session cookies.
# Generate one with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"

# Password used only once, when you run `npm run db:seed`, to create the
# admin account (username: admin). Change this before seeding in production.
ADMIN_SEED_PASSWORD="hnicecream46"

# ── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
